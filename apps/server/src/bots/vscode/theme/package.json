{
  "name": "t3-theme",
  "displayName": "T3 Code Theme",
  "version": "1.0.0",
  "description": "T3 Code's default look, generated by scripts/friend/vscode-theme.ts. Syntax colors from @pierre/theme (Apache-2.0).",
  "categories": [
    "Themes"
  ],
  "license": "Apache-2.0",
  "publisher": "t3code",
  "contributes": {
    "themes": [
      {
        "label": "T3 Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/t3-dark.json"
      },
      {
        "label": "T3 Light",
        "uiTheme": "vs",
        "path": "./themes/t3-light.json"
      }
    ],
    "configurationDefaults": {
      "window.autoDetectColorScheme": true,
      "workbench.preferredDarkColorTheme": "T3 Dark",
      "workbench.preferredLightColorTheme": "T3 Light",
      "workbench.colorTheme": "T3 Dark",
      "editor.fontFamily": "\"SF Mono\", \"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace",
      "editor.fontSize": 13,
      "terminal.integrated.fontSize": 13
    }
  },
  "engines": {
    "vscode": "^1.80.0"
  }
}
