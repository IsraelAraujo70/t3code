#!/usr/bin/env bash
# Claude Code for a guest's bot, run inside that guest's Docker sandbox (friend fork).
#
# A `claudeAgent` provider instance uses this file as its binary and names the guest with
# T3CODE_GUEST_ID in its environment. The Agent SDK spawns it like the real `claude`: arguments
# in, stream-json over stdin/stdout. Each provider session is one `docker run --rm -i`, so when
# T3 releases the idle session (idle timeout, Restart session, the guest idle reaper) the SDK
# closes stdin, Claude exits and the container is removed. Conversations survive in the guest's
# volume, so the next session resumes them.
#
# The container never sees the host's environment, files or keys:
# - Only the guest's volume (/home/guest) and the read-only git deploy key are mounted.
# - Its network is `--internal`: no route to the host, the LAN, the tailnet or the internet.
#   The only way out is the guest's proxy container, which refuses every non-public address.
# - The Anthropic credential is mounted only in that proxy container: a Claude subscription OAuth
#   token (`claude-oauth.token`, from `claude setup-token`) when present, otherwise an API key
#   (`anthropic.key`). The bot calls the API through the proxy's forwarder (http://egress:8080)
#   with a placeholder of the same kind, so its Claude Code runs as a subscription client or an
#   API client; the forwarder adds the real credential and enforces the guest's allowed models and
#   maximum effort (T3CODE_GUEST_ANTHROPIC_MODELS, T3CODE_GUEST_ANTHROPIC_MAX_EFFORT).
# - The same holds for Lurian's Bot API token (`lurian-bot.token`): the proxy forwards
#   LURIAN_BOT_API_URL (http://egress:8081/api/bot/v1) to Lurian with the token added, and
#   nothing else on that host gets it.
# - And for the guest's own Google account (`google/credentials.json`, written by
#   `cli.ts google-login`): the proxy forwards GOOGLE_API_URL (http://egress:8082) to the Gmail,
#   Sheets, Calendar and Drive APIs with a fresh access token. /opt/t3-guest/google-apis.md shows
#   the bot how to use it.
# - Non-root, all capabilities dropped, no-new-privileges, read-only root, memory/CPU/pids caps.
# - No variable of the T3 server process is forwarded, except the SDK's own two identifiers.
set -euo pipefail

die() {
  echo "t3-guest-claude: $*" >&2
  exit 64
}

guest="${T3CODE_GUEST_ID:-}"
[[ "$guest" =~ ^[a-z][a-z0-9-]{0,31}$ ]] || die "T3CODE_GUEST_ID is missing or invalid."

image="${T3CODE_GUEST_IMAGE:-t3-guest-sandbox:latest}"
secrets_dir="${T3CODE_GUEST_SECRETS_DIR:-$HOME/.config/t3-$guest}"
anthropic_key="${T3CODE_GUEST_ANTHROPIC_KEY_FILE:-$secrets_dir/anthropic.key}"
oauth_token="${T3CODE_GUEST_CLAUDE_OAUTH_TOKEN_FILE:-$secrets_dir/claude-oauth.token}"
# The subscription token takes precedence; only the credential in use is mounted.
if [[ -r "$oauth_token" ]]; then
  credential=(--mount "type=bind,src=$oauth_token,dst=/run/secrets/claude-oauth.token,readonly")
  placeholder=(-e CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-guest-sandbox-placeholder)
elif [[ -r "$anthropic_key" ]]; then
  credential=(--mount "type=bind,src=$anthropic_key,dst=/run/secrets/anthropic.key,readonly")
  placeholder=(-e ANTHROPIC_API_KEY=sk-guest-sandbox-placeholder)
else
  credential=()
  placeholder=(-e ANTHROPIC_API_KEY=sk-guest-sandbox-placeholder)
fi
google_dir="${T3CODE_GUEST_GOOGLE_DIR:-$secrets_dir/google}"
# The folder, not the file: a new login replaces the file, and a file mount would keep the old one.
[[ -d "$google_dir" ]] &&
  credential+=(--mount "type=bind,src=$google_dir,dst=/run/secrets/google,readonly")
placeholder+=(-e GOOGLE_API_URL=http://egress:8082 -e GOOGLE_APIS_DOC=/opt/t3-guest/google-apis.md)
lurian_token="${T3CODE_GUEST_LURIAN_TOKEN_FILE:-$secrets_dir/lurian-bot.token}"
if [[ -r "$lurian_token" ]]; then
  credential+=(--mount "type=bind,src=$lurian_token,dst=/run/secrets/lurian-bot.token,readonly")
  placeholder+=(-e LURIAN_BOT_API_URL=http://egress:8081/api/bot/v1)
fi
git_key="${T3CODE_GUEST_GIT_KEY_FILE:-$secrets_dir/git_deploy_key}"
memory="${T3CODE_GUEST_MEMORY:-2g}"
cpus="${T3CODE_GUEST_CPUS:-2}"
pids="${T3CODE_GUEST_PIDS:-512}"
models="${T3CODE_GUEST_ANTHROPIC_MODELS:-claude-sonnet-5-5,claude-haiku-5-5}"
max_effort="${T3CODE_GUEST_ANTHROPIC_MAX_EFFORT:-high}"
fake="${T3CODE_GUEST_FAKE_ANTHROPIC:-}"

network="t3-guest-$guest"
# Outside the `t3-guest-<id>` names, so no guest id can ever name the routed bridge.
egress_network="t3-guests_egress"
proxy="t3-guest-$guest-egress"
volume="t3-guest-$guest-home"
# The image's `guest` user; secret files must be readable by this uid.
uid="1000:1000"

docker image inspect "$image" >/dev/null 2>&1 ||
  die "image $image is missing. Build it: docker build -t $image apps/server/src/bots/guest/sandbox"

if [[ "${1:-}" == "--version" || "${1:-}" == "-v" ]]; then
  exec docker run --rm --network none --user "$uid" --cap-drop ALL \
    --security-opt no-new-privileges "$image" claude --version
fi

hardening=(
  --user "$uid"
  --cap-drop ALL
  --security-opt no-new-privileges
  --read-only
  --tmpfs /tmp:rw,nosuid,nodev,size=512m
  --label "t3.guest=$guest"
)

# Idempotent, and serialized per guest so two sessions starting at once do not race to create
# the same network or proxy.
ensure_infra() {
  docker network inspect "$network" >/dev/null 2>&1 ||
    docker network create --internal --ipv6=false --label "t3.guest=$guest" "$network" >/dev/null
  # Never run a bot on a network with a route out, whoever created it.
  [[ "$(docker network inspect -f '{{.Internal}}' "$network")" == "true" ]] ||
    die "network $network exists but is not --internal; remove it and retry."
  docker network inspect "$egress_network" >/dev/null 2>&1 ||
    docker network create --ipv6=false --label t3.guest=egress "$egress_network" >/dev/null

  local proxy_mounts=("${credential[@]}") config
  # A rebuilt image, changed limit, credential file or mode recreates the proxy; the credential's
  # content is read per request.
  config="$(printf '%s|' "$(docker image inspect -f '{{.Id}}' "$image")" "$models" "$max_effort" "$fake" "${proxy_mounts[*]:-}" | sha256sum | cut -c1-16)"
  if [[ "$(docker container inspect -f '{{.State.Running}} {{index .Config.Labels "t3.guest.config"}}' "$proxy" 2>/dev/null)" != "true $config" ]]; then
    docker rm -f "$proxy" >/dev/null 2>&1 || true
    docker run -d --name "$proxy" --restart unless-stopped --network "$egress_network" \
      "${hardening[@]}" --label "t3.guest.config=$config" \
      --memory 256m --cpus 0.5 --pids-limit 64 \
      "${proxy_mounts[@]}" \
      -e "T3_GUEST_ANTHROPIC_MODELS=$models" \
      -e "T3_GUEST_ANTHROPIC_MAX_EFFORT=$max_effort" \
      -e "T3_GUEST_FAKE_ANTHROPIC=$fake" \
      "$image" node /opt/t3-guest/proxy-main.mjs >/dev/null
  fi
  if ! docker container inspect -f '{{json .NetworkSettings.Networks}}' "$proxy" |
    grep -q "\"$network\""; then
    docker network connect --alias egress "$network" "$proxy"
  fi
}

# `--sandbox-exec <command...>` runs a command in the same container instead of Claude: for the
# owner to inspect a guest's sandbox and for the container tests. Only whoever runs this file can
# pass it; the T3 server passes the Agent SDK's arguments, never a guest's.
command=(claude)
if [[ "${1:-}" == "--sandbox-exec" ]]; then
  shift
  (($#)) || die "--sandbox-exec needs a command."
  command=()
fi

lock="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/t3-guest-$guest.lock"
(
  flock -w 60 9 || die "timed out waiting for $lock"
  ensure_infra
) 9>"$lock"

# Host paths mean nothing inside the container; T3 passes its workspace and attachments
# directories, and images reach Claude inline, not by path.
args=()
while ((${#command[@]})) && (($#)); do
  case "$1" in
  --add-dir | --plugin-dir | --plugin-dir-no-mcp | --debug-file | --mcp-config)
    shift 2 || shift
    ;;
  --add-dir=* | --plugin-dir=* | --plugin-dir-no-mcp=* | --debug-file=* | --mcp-config=*)
    shift
    ;;
  *)
    args+=("$1")
    shift
    ;;
  esac
done

mounts=(--mount "type=volume,src=$volume,dst=/home/guest")
[[ -r "$git_key" ]] &&
  mounts+=(--mount "type=bind,src=$git_key,dst=/run/secrets/git_deploy_key,readonly")

env=(
  -e HTTPS_PROXY=http://egress:3128 -e https_proxy=http://egress:3128
  -e HTTP_PROXY=http://egress:3128 -e http_proxy=http://egress:3128
  -e NO_PROXY=localhost,127.0.0.1,egress -e no_proxy=localhost,127.0.0.1,egress
  -e ANTHROPIC_BASE_URL=http://egress:8080
  "${placeholder[@]}"
  -e "T3_GUEST_ID=$guest"
  -e "T3_GUEST_GIT_NAME=${T3CODE_GUEST_GIT_NAME:-}"
  -e "T3_GUEST_GIT_EMAIL=${T3CODE_GUEST_GIT_EMAIL:-}"
  -e "T3_GUEST_GIT_REMOTE=${T3CODE_GUEST_GIT_REMOTE:-}"
  -e "T3_GUEST_GIT_DIR=${T3CODE_GUEST_GIT_DIR:-}"
)
for name in CLAUDE_CODE_ENTRYPOINT CLAUDE_AGENT_SDK_VERSION; do
  [[ -n "${!name:-}" ]] && env+=(-e "$name")
done

exec docker run --rm -i --init \
  --name "t3-guest-$guest-$(date +%s)-$$" \
  --network "$network" --dns-search . \
  "${hardening[@]}" \
  --memory "$memory" --memory-swap "$memory" --cpus "$cpus" --pids-limit "$pids" \
  "${mounts[@]}" \
  "${env[@]}" \
  "$image" t3-guest-entrypoint "${command[@]}" "${args[@]}" "$@"
